# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Required in production (minimum 32 characters; minimum 16 characters in development).
JWT_SECRET=""

# GATEWAY_ENCRYPTION_KEY: Required in production (minimum 16 characters).
GATEWAY_ENCRYPTION_KEY=""

# DATABASE_URL: Required in production for remote PostgreSQL (uses embedded PGlite in local development if omitted).
DATABASE_URL=""

# RESEND_API_KEY: Optional in development, required in production to send emails via Resend.
RESEND_API_KEY=""

# EMAIL_FROM: Configured sender address for outgoing emails.
EMAIL_FROM=""

# GCS_BUCKET_NAME: Optional in development, required in production for Google Cloud Storage.
GCS_BUCKET_NAME=""

# PAYMENT_SIMULATION_ENABLED: Set to "true" in non-production environments to allow simulated checkouts.
PAYMENT_SIMULATION_ENABLED="false"

# PAYPAL_MODE: "sandbox" or "live"
PAYPAL_MODE="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
