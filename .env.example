# ==============================================================================
# REQUIRED IN PRODUCTION
# ==============================================================================

# Application execution environment ("production" or "development")
NODE_ENV="development"

# Port on which the Express HTTP server listens
PORT="3000"

# Public canonical base URL used for links, webhooks, and redirects
APP_URL="http://localhost:3000"

# Secret key for JWT signing (minimum 32 characters in production, 16 in development)
JWT_SECRET="replace-with-a-secure-random-secret-key-min-32-chars"

# Encryption key for payment gateway credentials (minimum 16 characters, distinct from JWT_SECRET)
GATEWAY_ENCRYPTION_KEY="replace-with-gateway-encryption-key-min-16-chars"

# Primary PostgreSQL connection URL (embedded PGlite is used if omitted in development)
DATABASE_URL="postgresql://user:password@localhost:5432/fivepa_dev"

# ==============================================================================
# OPTIONAL IN PRODUCTION (Integrations & Services)
# ==============================================================================

# API key for transactional emails via Resend (optional in dev, required for real emails)
RESEND_API_KEY=""

# Verified sender address for system and notification emails
EMAIL_FROM="notifications@workperhour.com"

# Google Cloud Storage bucket name for persistent deliverable uploads
GCS_BUCKET_NAME=""

# Fallback alias for Google Cloud Storage bucket name
CLOUD_STORAGE_BUCKET=""

# Google Cloud Project ID for cloud services
GOOGLE_CLOUD_PROJECT=""

# PayPal integration environment ("sandbox" or "live")
PAYPAL_MODE="sandbox"

# PayPal REST API Client ID
PAYPAL_CLIENT_ID=""

# PayPal REST API Client Secret (stored encrypted)
PAYPAL_CLIENT_SECRET=""

# PayPal registered Webhook ID for checkout verification
PAYPAL_WEBHOOK_ID=""

# Trust X-Forwarded-For headers from reverse proxies ("true" or "false")
TRUST_PROXY="true"

# Require email verification prompt on new-device login ("true" or "false")
USER_DEVICE_VERIFICATION="false"

# Review window in days before gig order deliverables auto-accept (defaults to 3)
REVIEW_WINDOW_DAYS="3"

# Master toggle for background automated review window release ("true" or "false")
AUTO_ACCEPT_ENABLED="true"

# Optional discrete PostgreSQL connection overrides
PGHOST=""
PGPORT="5432"
PGUSER=""
PGPASSWORD=""
PGDATABASE=""
PGSSL="false"
PGSSLMODE="prefer"
PGSSLREJECTUNAUTHORIZED="false"
PG_POOL_MAX="20"

# ==============================================================================
# TESTING & NON-PRODUCTION ONLY (Never enable in production)
# ==============================================================================

# Allow simulated credit card / mock checkout deposits without real payment gateways (TEST ONLY)
PAYMENT_SIMULATION_ENABLED="false"

# Expose mock 2FA verification codes in API responses for automated testing (TEST ONLY)
ALLOW_MOCK_CODES="false"

# Allow administrative database purge endpoint POST /api/admin/reset-data (TEST ONLY)
ALLOW_DATA_RESET="false"

# Custom directory for local embedded PGlite storage files (DEV ONLY)
PGLITE_DATA_DIR="./data/pgdata"

# File path for diagnostic debug logging (TEST/DEBUG ONLY)
DIAGNOSTIC_LOG_FILE=""

# Unix timestamp cutoff for legacy session token migration (TEST/MIGRATION ONLY)
LEGACY_TOKEN_COMPAT_UNTIL_MS=""
